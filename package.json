{
	"name": "reloop-email",
	"version": "2.0.0",
	"description": "Reloop Node.js SDK",
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"keywords": [
		"reloop",
		"sdk",
		"api"
	],
	"author": "Reloop Labs",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reloop-labs/reloop-node.git"
	},
	"devDependencies": {
		"@react-email/render": "^2.1.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^20.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsup": "^8.0.0",
		"typescript": "^5.0.0"
	},
	"peerDependencies": {
		"@react-email/render": ">=1.0.0",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"@react-email/render": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	}
}
